{
  "name": "@rizias/tt-testops",
  "version": "0.13.1",
  "description": "Тест-кейсы Allure TestOps в Markdown и HTML: командная строка",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rizias/tt-testops.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "tt-testops": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint . --max-warnings 0",
    "knip": "knip",
    "check": "npm run build && npm run typecheck && npm run lint && npm run knip && npm test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "version": "node scripts/changelog-release.mjs && node scripts/skill-version.mjs"
  },
  "dependencies": {
    "marked": "^18.0.11",
    "proper-lockfile": "^4.1.2",
    "update-notifier": "^7.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/commonmark": "^0.27.10",
    "@types/node": "^22.20.1",
    "@types/proper-lockfile": "^4.1.4",
    "@types/update-notifier": "^6.0.8",
    "commonmark": "^0.31.2",
    "eslint": "^10.9.1",
    "knip": "^6.34.0",
    "lefthook": "^2.1.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
